# Copie para .env.local e preencha.
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.sa-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=um-segredo-com-pelo-menos-32-caracteres
# Endereço do backend Java
NEXT_PUBLIC_JMF_API_URL=http://localhost:8080
# Google Maps (busca de locais, endereço ↔ mapa e mapas). Sem chave, usa o OpenStreetMap.
# APIs a ativar no Google Cloud: Maps JavaScript API, Places API (New), Geocoding API.
# Restrinja a chave por site: http://localhost:3000/* e o domínio da Vercel.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Opcional: Map ID criado em Google Cloud → Map Management (sem ele usa DEMO_MAP_ID, só para testes)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
