# ---------- Já existentes no projeto (Neon / Vercel) ----------
DATABASE_URL=postgresql://user:senha@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:senha@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.sa-east-1.aws.neon.tech/neondb/auth
# POSTGRES_URL / POSTGRES_URL_NON_POOLING também são aceitas como alternativa.

# ---------- Novas (somente backend) ----------
SPRING_PROFILES_ACTIVE=prod
JMF_CORS_ORIGINS=https://seu-frontend.vercel.app
JMF_STORAGE_DIR=/var/lib/jmf/attachments
# Opcionais
# JMF_AUTH_JWKS_URI=            # padrão: $NEON_AUTH_BASE_URL/.well-known/jwks.json
# JMF_AUTH_ISSUER=              # padrão: origem de NEON_AUTH_BASE_URL
# JMF_AUTH_AUDIENCE=
# JMF_ADMIN_ROLES=admin
# JMF_SERVICE_AREA_ENABLED=true
# JMF_SERVICE_RADIUS_KM=80
# DB_POOL_SIZE=10
# PORT=8080

# ---------- Somente desenvolvimento ----------
# JMF_AUTH_MODE=hmac
# JMF_DEV_JWT_SECRET=um-segredo-local-com-32-ou-mais-caracteres
